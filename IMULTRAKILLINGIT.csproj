<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>IMULTRAKILLINGIT</AssemblyName>
    <Product>IM ULTRAKILLING IT</Product>
    <GUID>com.realk.ultrakill.imultrakillingit</GUID>
    <Version>0.3.5</Version>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <UltrakillDirectory Condition="'$(UltrakillDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</UltrakillDirectory>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>IMULTRAKILLINGIT</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="UltraModding.PluginInfoGenerator" Version="4.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.28" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(UltrakillDirectory)\ULTRAKILL_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="InstallPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(UltrakillDirectory)\BepInEx\plugins\IMULTRAKILLINGIT" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UltrakillDirectory)\BepInEx\plugins\IMULTRAKILLINGIT" SkipUnchangedFiles="true" />
  </Target>
  
</Project>
